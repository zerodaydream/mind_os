# Copy to .env and fill in locally — never commit .env

MINDOS_SECRET_KEY=
MINDOS_LLM_MODE=degraded
HF_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

MINDOS_LLM_DAILY_USD=2.00
MINDOS_LLM_MONTHLY_USD=40.00
MINDOS_LLM_KILL_SWITCH=0

MINDOS_DEFAULT_PROVIDER=google
MINDOS_ROUTER_MODEL=
MINDOS_EXTRACT_MODEL=
MINDOS_SYNTH_MODEL=
MINDOS_THINKING_LEVEL=MEDIUM

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
CHUNKER_VERSION=v2
MINDOS_GMAIL_SUBJECT_SKIP_REGEX=

