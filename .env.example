# Copy to .env for local development. Never commit .env.
# Secrets belong in the macOS Keychain (`ops auth ...`, Phase 5). GEMINI_API_KEY is a dev-only fallback.

# --- Database ---------------------------------------------------------------
OPS_DATABASE_URL=postgresql://opsagent:opsagent@localhost:5433/opsagent
OPS_DB_POOL_MAX=10

# --- Models (IDs are configuration; there are no defaults in code) ----------
OPS_MODEL_ORCHESTRATOR=
OPS_MODEL_SUBAGENT=
OPS_MODEL_UTILITY=                 # routing/titles/summaries; falls back to OPS_MODEL_SUBAGENT
OPS_MODEL_EMBEDDING=
OPS_EMBEDDING_DIMENSIONS=
# Reasoning effort per role: minimal|low|medium|high|xhigh (checked against the model profile)
OPS_REASONING_ORCHESTRATOR=high
OPS_REASONING_SUBAGENT=low
OPS_REASONING_UTILITY=minimal
OPS_INCLUDE_THOUGHTS=true
# Gemini 2.5 only: OPS_THINKING_BUDGET=   (0 off, -1 dynamic, or a token cap)
# GEMINI_API_KEY=

# --- Agent limits -----------------------------------------------------------
OPS_MAX_PARALLEL_SUBAGENTS=3
OPS_RUN_DEADLINE_SECONDS=900
OPS_MAX_AGENT_STEPS=25             # model/tool rounds for the orchestrator
OPS_SUBAGENT_MAX_STEPS=12          # rounds for one subagent invocation
OPS_MAX_TOOL_CALLS=40              # across the orchestrator and all subagents in a run

# --- Time and cost ----------------------------------------------------------
# OPS_TIMEZONE=Asia/Kolkata        # IANA name; unset uses the system zone
# Estimated cost shown in the status line. Set both, in USD per million tokens, or cost is hidden.
# OPS_PRICE_INPUT_PER_MTOK=
# OPS_PRICE_OUTPUT_PER_MTOK=

# --- Observability ----------------------------------------------------------
OPS_LOG_LEVEL=INFO
OPS_LOG_DIR=~/Library/Logs/opsagent
