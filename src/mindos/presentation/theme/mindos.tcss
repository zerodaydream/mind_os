/* All colors come from presentation/tokens.py via $mindos-* variables. */

Screen {
    layout: vertical;
    background: transparent;
    color: $mindos-text;
}

#transcript {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-color: $mindos-border;
    scrollbar-color-hover: $mindos-dim;
    scrollbar-background: transparent;
}

#spinner {
    height: 1;
    padding: 0 1;
}

#approval-host {
    height: auto;
}

ApprovalDialog {
    height: auto;
    border: round $mindos-warn;
    border-title-color: $mindos-warn;
    padding: 0 1;
    margin: 0 0;
}

ApprovalDialog:focus {
    border: round $mindos-accent;
    border-title-color: $mindos-accent;
}

#approval-options {
    margin-top: 1;
}

#approval-input {
    border: none;
    background: $mindos-user-bg;
    height: 1;
    padding: 0 1;
}

.hidden {
    display: none;
}

#prompt-box {
    height: auto;
    border: round $mindos-border;
    padding: 0 1;
}

#prompt-box:focus-within {
    border: round $mindos-accent;
}

#prompt-glyph {
    width: 2;
    color: $mindos-dim;
}

#prompt {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
}

#prompt:focus {
    border: none;
}

#prompt .text-area--cursor-line {
    background: transparent;
}

#hint {
    height: 1;
    padding: 0 2;
}

#status {
    height: 1;
    padding: 0 2;
}

PickerScreen {
    align: center middle;
    background: $mindos-user-bg 60%;
}

#picker {
    width: 80%;
    max-width: 90;
    height: auto;
    max-height: 80%;
    border: round $mindos-accent;
    padding: 0 1;
    background: $surface;
}

#picker-title {
    text-style: bold;
    color: $mindos-accent;
    padding-bottom: 1;
}

#picker-list {
    height: auto;
    max-height: 20;
    border: none;
    background: transparent;
}

#picker-hint {
    color: $mindos-dim;
    padding-top: 1;
}
